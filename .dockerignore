# .dockerignore file for optimal Docker builds

# Node.js specific
node_modules/
npm-debug.log
yarn-debug.log

# Development artifacts
.idea/
.vscode/
*.swp
*.swo
dist/
build/
out/

# Version control
.git/
.gitignore

# Environment and secrets
.env*
*.env
*.pem
*.key
*.crt

# Project-specific patterns
docs/
*.md
README*
Dockerfile*
docker-compose*
tmp/
temp/
*.tmp
.local/
local/

# Exclude specific files or directories
!public/
!resources/

# Temporary files
*.log

# Ensure no sensitive files are included
*.lock

# Add any additional project-specific exclusions below
